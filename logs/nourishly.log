[2026-01-02 18:00:12] INFO[budget_bytes_recipe_discovery:26] - Recipe data: RecipeData(title='Stuffed Poblano Peppers', source_url='https://www.budgetbytes.com/stuffed-poblano-peppers/', description='Stuffed poblano peppers are a fun, filling, and flavorful vegetarian meal. The southwest flavors are vibrant while beans and rice keep you feeling full.', ingredients=[IngredientData(name='long grain rice', quantity=1.0, unit='cup', notes='uncooked', original_text='1 cup uncooked long grain rice ($0.30)'), IngredientData(name='bullion', quantity=2.0, unit='cubes', notes=None, original_text='2 cubes bullion, vegetable, or chicken ($0.24)'), IngredientData(name='chili powder', quantity=0.25, unit='teaspoon', notes=None, original_text='1/4 tsp chili powder ($0.05)'), IngredientData(name='fresh cilantro', quantity=0.25, unit='bunches', notes=None, original_text='1/4 bunch fresh cilantro ($0.17)'), IngredientData(name='poblano peppers', quantity=6.0, unit='', notes=None, original_text='6 poblano peppers ($2.98)'), IngredientData(name='cheese', quantity=4.0, unit='ounce', notes=None, original_text='4 oz. cheese ($0.99)'), IngredientData(name='salsa', quantity=0.75, unit='cup', notes='divided', original_text='3/4 cup divided salsa ($0.52)'), IngredientData(name='black beans', quantity=1.0, unit='can', notes=None, original_text='1 15oz. can black beans ($0.87)'), IngredientData(name='non-stick spray', quantity=None, unit=None, notes=None, original_text='non-stick spray (if needed) ($0.10)')], instructions=['Cook the rice in a medium pot with 1.75 cups of water and two buillion cubes. (instructions for cooking rice here) While the rice is cooking, finely chop the cilantro. Mix the cilantro and chili powder into the rice after it has finished cooking. Set the rice aside until you are ready to use it.', 'While the rice is cooking, roast the poblanos. Preheat the broiler to 400 degrees. Spray a baking sheet and coat all sides of the poblano peppers with non-stick spray (you can rub olive oil all over them but I find spraying is much easier). Place the baking sheet a few inches under the broiler (I use the second rack level) and broil on each side for 5 minutes.', 'After broiling the poblanos, the skin should be blistered and bubbly. Immediately place the peppers into a ziplock bag for about 15 minutes to allow the steam to loosen the skin. Remove them from the bag and peel away as much of the skin as possible (be gentle and it is okay if you can’t get ALL of the skin).', 'Cut a boat shaped piece out of each pepper and then carefully remove the seeds and seed pod. Save the pieces of pepper that are removed to make the openings because it makes a great ingredient for salads, burrito bowls or quesadillas (breakfast quesadilla anyone?).', 'Preheat the oven to 350 degrees (bake, not broil this time). Gently fill the peppers with layers of seasoned rice, salsa, cheese and beans. I began with rice (1/3 to 1/2 cup), then 1 Tbsp of salsa, 1/3 oz. of cheese, beans (as much as I could stuff in), then more salsa and cheese (same amounts as before).', 'Place the peppers back in the oven and bake until they are heated through and the cheese is melted (about 20 minutes). Enjoy!'], prep_time=30, cook_time=90, servings='6 servings', cuisine_type='Southwest', difficulty_level=None, image_url='https://www.budgetbytes.com/wp-content/uploads/2010/02/Stuffed20Poblanos202.jpg', nutrition={'servingSize': '1 Serving', 'calories': '290.52 kcal', 'carbohydrateContent': '47.75 g', 'proteinContent': '13.53 g', 'fatContent': '5.08 g', 'fiberContent': '9.8 g', 'sodiumContent': '921.68 mg'}, macros=MacroNutrition(calories=290.52, protein=13.53, carbohydrates=47.75, fat=5.08, fiber=9.8, sugar=None, sodium=921.68, saturated_fat=None, cholesterol=None), tags=['Diner,Main Course,Side Dish', 'Southwest'], dietary_restrictions=[], author='Beth Moncel', rating=4.67, provider=None)
