[2026-01-08 18:29:27] INFO [recipes.management.commands.budget_bytes_recipe_discovery:31] Recipe data: RecipeData(title='Chai Spiced Scones', source_url='https://www.budgetbytes.com/chai-spiced-scones/', description='Simple scones spiced with classic chai spices like cinnamon, ginger, and cloves.', ingredients=[IngredientData(name='all-purpose flour', quantity=2.0, unit='cup', notes=None, original_text='2 cups all-purpose flour ($0.20)'), IngredientData(name='sugar', quantity=3.0, unit='Tbsps', notes=None, original_text='3 Tbsp sugar ($0.03)'), IngredientData(name='salt', quantity=0.5, unit='teaspoon', notes=None, original_text='1/2 tsp salt ($0.02)'), IngredientData(name='baking powder', quantity=2.0, unit='teaspoon', notes=None, original_text='2 tsp baking powder ($0.06)'), IngredientData(name='cinnamon', quantity=1.0, unit='teaspoon', notes=None, original_text='1 tsp cinnamon ($0.05)'), IngredientData(name='ground ginger', quantity=0.5, unit='teaspoon', notes=None, original_text='1/2 tsp ground ginger ($0.05)'), IngredientData(name='ground cloves', quantity=0.5, unit='teaspoon', notes=None, original_text='1/2 tsp ground cloves ($0.05)'), IngredientData(name='ground cardamom', quantity=0.25, unit='teaspoon', notes=None, original_text='1/4 tsp ground cardamom ($0.03)'), IngredientData(name='cold butter', quantity=5.0, unit='Tbsps', notes=None, original_text='5 Tbsp cold butter ($0.43)'), IngredientData(name='milk', quantity=0.25, unit='cup', notes=None, original_text='1/4 cup milk ($0.06)'), IngredientData(name='eggs', quantity=2.0, unit='', notes=None, original_text='2 large eggs ($0.47)')], instructions=['Preheat the oven to 450 degrees. In a large bowl combine the flour, sugar, salt, baking powder, cinnamon, ginger, cloves, and cardamom. Stir until everything is well combined.', 'Make sure the butter is cold. Cut it into chunks and then add it to the flour mixture. Use your hands to rub or smoosh the butter into the flour until the mixture has a grainy appearance.', 'In a separate small bowl, whisk together the eggs and milk. Pour the egg mixture into the bowl with the flour and butter. Stir everything together until it forms one lump of very moist dough. If it remains crumbly with dry flour on the bottom of the bowl, add a small amount of water (about 1/2 to 1 tablespoon) to make it come together.', 'Turn the dough out onto a lightly floured surface and shape it into one flat disc for regular sized scones, or two flat discs for mini scones. The discs should be about one inch thick each. Sprinkle the top of the dough with granulated sugar, if desired. Cut the disc(s) into eight wedge-shaped pieces.', 'Place the dough wedges on a baking sheet covered with parchment paper. Bake the scones in the fully preheated oven for 15-17 minutes or until lightly golden brown on top.'], prep_time=15, cook_time=15, servings=8, cuisine_type=None, difficulty_level=None, image_url='https://www.budgetbytes.com/wp-content/uploads/2013/01/ChaiSconescrumble.jpg', nutrition={'servingSize': '1 Serving', 'calories': '220.29 kcal', 'carbohydrateContent': '29.59 g', 'proteinContent': '5.15 g', 'fatContent': '8.85 g', 'fiberContent': '1.09 g', 'sodiumContent': '316.29 mg'}, macros=MacroNutrition(calories=220.29, protein=5.15, carbohydrates=29.59, fat=8.85, fiber=1.09, sugar=44.7, sodium=316.29, saturated_fat=41.00000000000001, cholesterol=533.0, monounsaturated_fat=None, polyunsaturated_fat=None), tags=[], dietary_restrictions=[], author='Beth Moncel', rating=4.15, provider=None)
