[2026-01-08 18:34:45] INFO [recipes.management.commands.budget_bytes_recipe_discovery:31] Recipe data: RecipeData(title='Cranberry Walnut Bread', source_url='https://www.budgetbytes.com/cranberry-walnut-bread/', description='This super easy cranberry walnut bread requites no kneading and bakes up to a nice chewy interior and perfectly crispy crust.', ingredients=[IngredientData(name='whole wheat flour', quantity=1.0, unit='cup', notes=None, original_text='1 cup whole wheat flour ($0.16)'), IngredientData(name='bread flour', quantity=2.25, unit='cup', notes=None, original_text='2 1/4 cups bread flour ($0.33)'), IngredientData(name='salt', quantity=1.25, unit='teaspoon', notes=None, original_text='1 1/4 tsp salt ($0.05)'), IngredientData(name='instant yeast', quantity=0.75, unit='Tbsps', notes=None, original_text='3/4 Tbsp instant yeast ($0.20)'), IngredientData(name='walnuts', quantity=0.25, unit='cup', notes='chopped', original_text='1/4 cup chopped walnuts ($0.42)'), IngredientData(name='dried cranberries', quantity=0.25, unit='cup', notes=None, original_text='1/4 cup dried cranberries ($0.30)'), IngredientData(name='water', quantity=1.25, unit='cup', notes=None, original_text='1 1/4 cups water ($0.00)'), IngredientData(name='cornmeal', quantity=2.0, unit='Tbsps', notes=None, original_text='2 Tbsp cornmeal ($0.03)')], instructions=['In a large bowl or pot, combine the dry ingredients (flours, salt, yeast, cranberries and walnuts. Cornmeal not included). Add the water and stir until a shaggy ball forms.', 'Let the dough sit at room temperature with a loose cover (I use the lid to the pot, slightly cocked so gasses can escape) for two hours. After two hours turn the dough out onto a floured surface and give it 3 or four turns (or kneads) just to make a coherent, smooth ball. Cut into two or leave as one large piece of dough. Shape into a round ball.', 'Place the shaped dough onto a baking sheet covered with parchment paper and sprinkled with cornmeal. Let rise for at least one hour or until double in size. At the end of the rise, preheat the oven to 450 degrees.', 'Using a sharp knife or a serrated bread knife, gently make a few slits across the top of the dough. Brush or spritz the dough with water and bake for about 30 minutes or until the crust is a deep golden brown. Remove from the oven and cool on a wire rack.'], prep_time=190, cook_time=30, servings=12, cuisine_type='American', difficulty_level=None, image_url='https://www.budgetbytes.com/wp-content/uploads/2010/12/720baked.jpg', nutrition={'servingSize': '1 Serving', 'calories': '161.92 kcal', 'carbohydrateContent': '30.55 g', 'proteinContent': '5.21 g', 'fatContent': '2.43 g', 'fiberContent': '2.29 g', 'sodiumContent': '247.27 mg'}, macros=MacroNutrition(calories=161.92, protein=5.21, carbohydrates=30.55, fat=2.43, fiber=2.29, sugar=57.2, sodium=247.27, saturated_fat=12.399999999999999, cholesterol=None, monounsaturated_fat=None, polyunsaturated_fat=None), tags=['Bread,Dinner,Lunch', 'American'], dietary_restrictions=[], author='Beth Moncel', rating=4.64, provider=None)
