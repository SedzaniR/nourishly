[2026-01-08 18:28:48] INFO [recipes.management.commands.budget_bytes_recipe_discovery:31] Recipe data: RecipeData(title='Flour Tortillas', source_url='https://www.budgetbytes.com/flour-tortillas/', description='Classic flour tortillas are easy to make and require just a few ingredients.', ingredients=[IngredientData(name='whole wheat flour', quantity=0.75, unit='cup', notes=None, original_text='3/4 cup whole wheat flour ($0.12)'), IngredientData(name='all-purpose flour', quantity=2.0, unit='cup', notes=None, original_text='2 cups all-purpose flour ($0.29)'), IngredientData(name='lard', quantity=5.0, unit='Tbsps', notes=None, original_text='5 Tbsp lard ($0.22)'), IngredientData(name='salt', quantity=0.75, unit='teaspoon', notes=None, original_text='3/4 tsp salt ($0.05)'), IngredientData(name='warm water', quantity=0.75, unit='cup', notes=None, original_text='3/4 cup warm water ($0.00)')], instructions=['Combine the flours in a large bowl and stir until evenly mixed. Add the lard and work it in with your hands until the flour is coated in lard you have an even, crumbly mixture (looks like coarse sand).', 'Dissolve the salt into the warm water. Add the salt water to the flour/lard a little at a time until a cohesive ball has formed. You may need more or less water depending on the moisture content of your flour.', 'Once you have a rough ball of dough, turn it out onto a lightly floured surface and knead it for a minute or two or just until everything is evenly mixed. The dough will be fairly stiff and quite unlike regular bread dough so don’t worry if it is difficult to knead.', 'Divid the dough into 8 pieces (for large tortillas) or 12 (for smaller, 6-inch tortillas). Do your best to shape them into balls and let them sit for 30 minutes, covered with a damp towel.', 'After the dough has rested it will be much softer and easier to roll out. Roll each ball into a very thin circle (about the thickness of poster board). You can pile the rolled tortillas, one on top of the other until you are finished rolling.', 'Heat a heavy bottomed skillet over a medium flame. Once the pan is fully preheated, place one tortilla in at a time. Wait for it to bubble up and turn slightly golden then flip and cook the second side in the same manner (about 30 seconds each side). As each tortilla comes out of the skillet, pile them on a plate and cover with a damp cloth to keep soft and warm.'], prep_time=15, cook_time=30, servings=8, cuisine_type='Southwest', difficulty_level=None, image_url='https://www.budgetbytes.com/wp-content/uploads/2011/01/Tortillas20lard.jpg', nutrition={'servingSize': '1 Serving', 'calories': '223.88 kcal', 'carbohydrateContent': '31.95 g', 'proteinContent': '4.71 g', 'fatContent': '8.59 g', 'fiberContent': '2.05 g', 'sodiumContent': '222.1 mg'}, macros=MacroNutrition(calories=223.88, protein=4.71, carbohydrates=31.95, fat=8.59, fiber=2.05, sugar=2.5, sodium=222.1, saturated_fat=29.6, cholesterol=68.0, monounsaturated_fat=None, polyunsaturated_fat=None), tags=['Bread,Dinner,Lunch', 'Southwest'], dietary_restrictions=[], author='Beth Moncel', rating=5.0, provider=None)
